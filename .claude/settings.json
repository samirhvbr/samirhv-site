{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_profile": "THIS FILE DOES NOT CHOOSE THE MODEL, ON PURPOSE (24/09/2026 — repodocs ADR-027). No `model`, no `fallbackModel`, and nothing in `env` that steers one: no `ANTHROPIC_MODEL`, no `ANTHROPIC_DEFAULT_*_MODEL`, no `CLAUDE_CODE_SUBAGENT_MODEL`. The model is the user's choice, made with /model, and a subagent inherits it. The highest effortLevel a FILE accepts is 'xhigh'; use /effort max for a single session.",
  "_comment_effort": "Max + adaptive thinking off = sempre raciocinio profundo",
  "effortLevel": "max",
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "_comment": "Permissões do projeto - Laravel/Blue3",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan migrate:status:*)",
      "Bash(php artisan view:clear:*)",
      "Bash(php artisan config:clear:*)",
      "Bash(php artisan cache:clear:*)",
      "Bash(php artisan route:clear:*)",
      "Bash(php artisan optimize:clear:*)",
      "Bash(php artisan tinker --execute:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan make:*)",
      "Bash(php -l:*)",
      "Bash(composer validate:*)",
      "Bash(composer show:*)",
      "Bash(composer install:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(node -c:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/phpunit:*)"
    ],
    "deny": [
      "Read(./storage/oauth-*.key)",
      "Read(./storage/*.pem)",
      "Read(./auth.json)",
      "Bash(rm -rf /:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(mysql:*)",
      "Bash(mariadb:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(php artisan migrate:*)",
      "Bash(composer require:*)",
      "Bash(composer update:*)",
      "Bash(npm install --save:*)",
      "Bash(mysqldump:*)",
      "Bash(mariadb-dump:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)"
    ]
  }
}
