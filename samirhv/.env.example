APP_NAME=Samirhv
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Admin único do painel (usado pelo AdminUserSeeder). Sem cadastro público.
# Se ADMIN_PASSWORD ficar vazio, o seeder gera uma senha aleatória e a imprime.
ADMIN_EMAIL=samirhv@me.com
ADMIN_NAME="Samir Hanna Verza"
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- Matomo Analytics (self-hosted em a.blue3.cloud) ---
# Rastreamento. O snippet só entra no <head> quando MATOMO_ENABLED=true E
# MATOMO_SITE_ID preenchido (ver config/services.php + partials/matomo.blade.php).
# Após ativar/alterar: php artisan config:cache (o deploy.sh já faz).
MATOMO_ENABLED=false
MATOMO_URL=https://a.blue3.cloud/
MATOMO_SITE_ID=2

# --- AI-MEMORY (admin, READ-ONLY) ---
# ABSOLUTE path of the ai-memory memory.sqlite ON THE HOST. ai-memory runs on the
# same server; 2.x installs under /opt/ai-memory, 1.x used the Docker volume
# `ai-memory-data`. Empty/unreachable => the admin "AI-MEMORY" screen degrades
# with a notice instead of breaking. Reading the file directly couples the app to
# THIS server. See docs/AI-MEMORY.md.
# www-data needs read on the file AND WRITE ON ITS DIRECTORY (WAL sidecar files).
# Finding the real path on the server:
#   2.x: ls -l /opt/ai-memory/data/db/memory.sqlite
#   1.x: docker volume inspect ai-memory-data -f '{{ .Mountpoint }}'   # + /db/memory.sqlite
AI_MEMORY_SQLITE_PATH=/opt/ai-memory/data/db/memory.sqlite

# --- GitHub View (admin) ---
# Dashboard de visualização de repositórios do GitHub. COMO CRIAR O TOKEN (passo a
# passo + troubleshooting): docs/GITHUB-VIEW.md. É um token FINE-GRAINED, SÓ LEITURA:
#   Metadata: Read (obrigatória) · Contents: Read (obrigatória) · Actions: Read (opcional, p/ CI)
# Criar em: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Owner default p/ nomes "curtos" no add-form (ex.: "repo" vira "samirhvbr/repo").
GITHUB_OWNER=samirhvbr
# Fuso p/ o bucket dia×hora dos charts (fallback: APP_TIMEZONE). Ex.: America/Sao_Paulo
APP_TIME_ZONE=America/Sao_Paulo
